<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " - " + site.title) if title else (site.title + " - " + site.tagline) %}
{% set pageDesc = description or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/retro.css">
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
<link rel="alternate" type="text/plain" title="llms-full.txt" href="/llms-full.txt">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="123ofnet.com - An easy solution to AI !!!">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ site.url }}/assets/og-image.png">
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
 {"@type":"Organization","@id":"{{ site.url }}/#org","name":"{{ site.title }}","url":"{{ site.url }}/","logo":"{{ site.url }}/assets/og-image.png","foundingDate":"{{ site.established }}","description":"{{ site.description }}","email":"{{ site.contactEmail }}"},
 {"@type":"WebSite","@id":"{{ site.url }}/#website","name":"{{ site.title }}","url":"{{ site.url }}/","description":"{{ site.description }}","publisher":{"@id":"{{ site.url }}/#org"},"inLanguage":"en","potentialAction":{"@type":"SearchAction","target":"{{ site.url }}/directory/?q={query}","query-input":"required name=query"}},
 {"@type":"WebPage","@id":"{{ site.url }}{{ page.url }}","url":"{{ site.url }}{{ page.url }}","name":{{ pageTitle | dump | safe }},"description":{{ pageDesc | dump | safe }},"isPartOf":{"@id":"{{ site.url }}/#website"},"dateModified":"{{ page.date | isoDate }}"}{% if crumbs %},
 {"@type":"BreadcrumbList","itemListElement":[{% for c in crumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ c.name | dump | safe }},"item":"{{ site.url }}{{ c.url }}"}{% if not loop.last %},{% endif %}{% endfor %}]}{% endif %}
]}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="page">

  <header class="topbar">
    <a class="logo" href="/">123<span>of</span>net<small>.com</small></a>
    <form class="search" action="/directory/" method="get" role="search">
      <label for="q" class="sr">Search AI tools</label>
      <input id="q" name="q" type="search" placeholder="What do you want to do with AI?">
      <button type="submit">Search</button>
    </form>
  </header>

  <nav class="navstrip" aria-label="Main">
    <a href="/">Home</a> |
    <a href="/directory/">AI Directory</a> |
    {% for cat in directory.categories %}<a href="/directory/{{ cat.slug }}/">{{ cat.name }}</a> | {% endfor %}
    <a href="/tools/">Free AI Tools</a> |
    <a href="/submit/"><b>Get Listed</b></a>
  </nav>

  <p class="strap"><span><b>123ofnet.com</b> - {{ site.tagline }}</span> <span class="strap-r">Est. {{ site.established }} by three enterprising students</span></p>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footbar">
    <p>
      <a href="/advertise/">ADVERTISE</a> |
      <a href="/about/">ABOUT US</a> |
      <a href="/submit/">GET LISTED</a> |
      <a href="/faq/">FAQ's</a> |
      <a href="/privacy/">PRIVACY POLICY</a> |
      <a href="/1999/">THE ORIGINAL SITE</a>
    </p>
  </footer>
  <p class="copy">&copy; {{ site.established }}&ndash;{{ "" | year }} 123ofnet.com &middot; Last updated: {{ site.lastUpdated }}</p>
</div>
<script src="/assets/search.js" defer></script>
</body>
</html>

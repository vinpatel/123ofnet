<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="stylesheet" href="/assets/retro.css">
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"{{ site.title }}","url":"{{ site.url }}","description":"{{ site.tagline }}","foundingDate":"{{ site.established }}","author":{"@type":"Person","name":"{{ site.webmaster }}"}}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="page">
  <header class="masthead">
    <p class="logo"><a href="/">123ofnet.com</a></p>
    <p class="tagline">{{ site.tagline }}</p>
  </header>

  <div class="marquee" aria-hidden="true"><span>*** Welcome back! 123ofnet.com is ONLINE again after 20+ years *** Sign the guestbook *** Join the webring *** Best viewed in Netscape Navigator at 800x600 ***</span></div>

  <div class="layout">
    <nav class="sidebar" aria-label="Main">
      <p class="nav-title">NAVIGATION</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/directory/">The Directory</a> <span class="new">NEW!</span></li>
        <li><a href="/1999/">The 1999 Site</a></li>
        <li><a href="/guestbook/">Guestbook</a></li>
        <li><a href="/webring/">Webring</a></li>
        <li><a href="/webmaster/">Ask the Webmaster</a></li>
      </ul>
      <hr>
      <p class="small">Best viewed in<br><b>Netscape Navigator 4.0</b><br>at 800x600</p>
    </nav>

    <main id="main" class="content">
      {{ content | safe }}
    </main>
  </div>

  <footer class="footer">
    <hr>
    <p class="counter-line">You are visitor number
      <span class="counter" aria-label="{{ site.hits }} visitors">{% for d in (site.hits | string).padStart(7, "0").split("") %}<span>{{ d }}</span>{% endfor %}</span>
    </p>
    <p class="small">&copy; {{ site.established }}&ndash;{{ "" | year }} {{ site.webmaster }} &middot; Last updated: {{ site.lastUpdated }}</p>
    <p class="webring-bar">[ <a href="/webring/">&lt;&lt; Prev</a> | <a href="/webring/">Random</a> | <a href="/webring/">List Sites</a> | <a href="/webring/">Next &gt;&gt;</a> ]<br><span class="small">This site is a member of the 123ofnet.com Webring</span></p>
  </footer>
</div>
</body>
</html>
